[Unit]
Description=Didban monitoring agent — دیدبان
Documentation=https://github.com/Mohammad1724/didban
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/didban/agent.conf
ExecStart=/usr/local/bin/didban-agent
Restart=always
RestartSec=5

# The agent manages validated tunnel configs and systemd services. Keep the OS
# image immutable while permitting its required /etc, /var and /run access.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
UMask=0077
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
